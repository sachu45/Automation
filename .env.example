# ---------------------------------------------------------------------------
# Personal Outreach — configuration. Copy to `.env` (repo root) and edit.
# Nothing here is required for a local trial: defaults are safe (localhost,
# SQLite, dry-run, template-mode AI). NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

APP_ENV=development
# Bind address. Keep 127.0.0.1 unless you deploy behind HTTPS (see docs/DEPLOYMENT.md).
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# Database. Empty = SQLite at backend/data/outreach.db
# PostgreSQL example: postgresql+psycopg://outreach:CHANGE_ME@localhost:5432/outreach
DATABASE_URL=

# Secrets. If empty, random keys are generated on first run and stored in
# backend/data/secret.key and backend/data/encryption.key (back these up!).
# SECRET_KEY signs sessions/CSRF; ENCRYPTION_KEY is a Fernet key for stored credentials.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# Optional: set the admin password non-interactively (otherwise use the first-run screen,
# which is only allowed from localhost).
ADMIN_PASSWORD=

# Set to true when served over HTTPS
COOKIE_SECURE=false
MAX_REQUEST_BYTES=1000000
MAX_UPLOAD_BYTES=10000000
# Only needed if the SPA is served from a different origin than the API
CORS_ORIGINS=

# Public HTTPS URL where /u/<token> is reachable (enables one-click unsubscribe links).
# Leave empty to rely on reply-based opt-out + mailto List-Unsubscribe.
PUBLIC_BASE_URL=

# AI (optional). template = deterministic, no AI. openai_compatible = any /chat/completions API.
AI_PROVIDER=template
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60

# Lead discovery (all optional; keys can also be saved encrypted in the UI: Lead discovery → Sources)
# Apollo: People Search uses 0 credits (no emails); enrichment uses credits and is off by default.
APOLLO_API_KEY=
# Google Custom Search JSON API: closed to new customers, shuts down 2027-01-01 (existing projects only)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Gemini for drafting: select "gemini" in Settings → AI. Free-tier limits vary by model/project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_INPUT_CHARS=12000
GEMINI_MAX_OUTPUT_TOKENS=1024
DISCOVERY_REQUEST_TIMEOUT_SECONDS=15
DISCOVERY_MAX_PAGES_PER_DOMAIN=5
DISCOVERY_MAX_PAGE_BYTES=1500000
DISCOVERY_DOMAIN_DELAY_SECONDS=1
# Targeting, intervals, limits, test mode and enable/disable live in the UI (stored in the database).

# OAuth apps you register yourself (optional; only for Gmail / Microsoft 365 OAuth accounts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Must match the redirect URI registered with the provider: <base>/api/accounts/oauth/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Worker
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=10
INBOX_SYNC_INTERVAL_MINUTES=10
STALE_JOB_MINUTES=15

# Docker Compose only
POSTGRES_PASSWORD=change-me
